<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        tools:context=".ui.settings.SettingsActivity"
        tools:showIn="@layout/activity_settings">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:orientation="vertical"
                android:padding="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/webhook_enabled_switch"
                    android:text="@string/settings_webhook_enabled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <EditText
                    android:id="@+id/webhook_url"
                    android:maxLines="1"
                    android:inputType="textUri"
                    android:imeOptions="actionDone"
                    android:hint="@string/settings_webhook_url_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="" />

                <EditText
                    android:id="@+id/webhook_bearer_token"
                    android:maxLines="1"
                    android:inputType="textPassword"
                    android:imeOptions="actionDone"
                    android:hint="@string/settings_webhook_bearer_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/webhook_skip_ongoing_switch"
                    android:text="@string/settings_webhook_skip_ongoing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:text="@string/settings_webhook_skip_ongoing_hint"
                    android:textSize="12sp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="8dp"
                    android:textColor="?android:textColorSecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <RadioGroup
                android:padding="8dp"
                android:id="@+id/mode_radio_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/mode_blacklist"
                    android:text="@string/settings_radio_blacklist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <RadioButton
                    android:id="@+id/mode_whitelist"
                    android:text="@string/settings_radio_whitelist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </RadioGroup>

            <EditText
                android:id="@+id/search"
                android:maxLines="1"
                android:imeOptions="actionDone"
                android:hint="@string/settings_search_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>