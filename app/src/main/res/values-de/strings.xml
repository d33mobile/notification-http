    <!-- title for the app list (single pane mode) -->
    <string name="title_app_list">Apps</string>

    <!-- description for clear history action -->
    <string name="action_clear">Verlauf löschen</string>

    <!-- dialog: clear history -->
    <string name="dialog_clear_all_title">Verlauf aller Anwendungen löschen?</string>
    <string name="dialog_clear_app_title">Verlauf von <xliff:g id="app" example="GMail">%1$s</xliff:g> löschen?</string>
    <string name="dialog_clear_text">Diese Aktion kann nicht rückgängig gemacht werden</string>
    <string name="dialog_clear_positive">Löschen</string>
    <string name="dialog_clear_negative">Abbrechen</string>

    <!-- text if there aren't any notifications saved -->
    <string name="notification_list_empty">Es wurden bis jetzt keine Benachrichtigungen gespeichert</string>

    <!-- card which says how to enable the notification logging -->
    <string name="card_enable_service_title">Berechtigung benötigt</string>
    <string name="card_enable_service_text">
        NotificationLog benötigt Ihre Genehmigung um auf Ihre Benachrichtigungen zuzugreifen und diese zu speichern.
        Die Daten werden nur auf Ihrem Gerät gespeichert und nicht übertragen.
    </string>
    <string name="card_enable_service_button">Erlauben</string>

    <!-- accessibility service dialog -->
    <string name="dialog_accessibility_service_title">Bedienhilfe</string>
    <string name="dialog_accessibility_service_text">NotificationLog
        würde den Benachrichtigungszugriff verwenden, wenn es ihn bei dieser
        Android-Version gäbe. Da es ihn hier nicht gibt, kann stattdessen
        die Bedienhilfe-Berechtigung verwendet werden. NotificationLog verwendet
        diesen nur, um die angezeigten Benachrichtigungen abzurufen und - abhängig von
        deinen Einstellungen - auf deinem Gerät zu speichern.
    </string>
    <string name="dialog_accessibility_service_yes">Berechtigung erteilen</string>
    <string name="dialog_accessibility_service_no">Abbrechen</string>

    <!-- card which informs that logging was disabled for one App -->
    <string name="card_logging_disabled_title">Protokollierung von %s wurde deaktiviert</string>
    <string name="card_logging_disabled_text">Sie können das im Menü andern</string>

